pluginManagement {
    repositories {
        gradlePluginPortal()
    }
}

plugins {
    id 'org.gradle.toolchains.foojay-resolver-convention' version '1.0.0'
}

rootProject.name = 'simply_screens-neoforge-26.1.2'
include 'packetweave-api'
project(':packetweave-api').projectDir = file('../packetweave-api')
